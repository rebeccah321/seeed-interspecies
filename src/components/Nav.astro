---
const base = import.meta.env.BASE_URL;
---

<div class="honeyguide-cursor" id="honeyguide-cursor">
  <svg viewBox="0 0 32 28" fill="none">
    <path d="M2 16c1-2 3-4 5-5l2-1c1-2 3-5 5-6 1 0 2 1 2 2 0 1-1 3-2 4l3 2c2 1 3 2 3 3s-1 2-3 3l-3 2c1 1 2 3 2 4 0 1-1 2-2 2-2-1-4-4-5-6l-2-1c-2-1-4-3-5-5z" fill="#1a231a" opacity="0.7"/>
    <circle cx="16" cy="12" r="1" fill="#fff" opacity="0.8"/>
  </svg>
</div>

<!-- ============ ENTER OVERLAY ============ -->
<div class="enter-overlay" id="enter-overlay">
  <canvas class="enter-canvas" id="enter-canvas"></canvas>
  <div class="enter-content">
    <div class="enter-title">Interspecies</div>
    <div class="enter-wave-row">
      <div class="left-text cover-fade">Life has been<br>sending signals<br>for 3.8 billion years.</div>
      <div class="wave-area cover-fade" id="wave-area">
        <canvas id="enter-wave-canvas"></canvas>
        <button class="wave-btn" id="enter-btn">
          Enter the Network
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
      <div class="right-text cover-fade">We're only now<br>learning to receive them.</div>
    </div>
    <div class="cover-slogan">Open hardware for animal &amp; ecological research</div>
  </div>
  <div class="enter-sub">Seeed Studio · Interspecies Initiative</div>
</div>

<!-- ============ NAV ============ -->
<nav id="nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="#top" class="flex items-center gap-2 brand-text text-ink font-display font-bold text-lg tracking-tight">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>
      Seeed<span>·</span>Interspecies
    </a>
    <div class="hidden md:flex items-center gap-7 text-sm">
      <a href="#why" class="nav-link text-muted hover:text-ink">Why Now</a><a href="#what" class="nav-link text-muted hover:text-ink">What We Do</a>
      <a href="#cases" class="nav-link text-muted hover:text-ink">Cases</a><a href="#people" class="nav-link text-muted hover:text-ink">People</a>
      <a href="#sdg" class="nav-link text-muted hover:text-ink">SDG</a><a href="#join" class="nav-link text-muted hover:text-ink">Join</a>
    </div>
    <a href="#contact" class="nav-cta hidden md:inline-flex items-center gap-2 pill border border-line px-5 py-2 text-sm text-ink hover:border-brand hover:text-brand">Get in touch</a>
    <button class="md:hidden text-ink" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-line px-6 py-4 space-y-3">
    <a href="#why" class="block text-sm text-muted">Why Now</a><a href="#what" class="block text-sm text-muted">What We Do</a>
    <a href="#cases" class="block text-sm text-muted">Cases</a><a href="#people" class="block text-sm text-muted">People</a>
    <a href="#sdg" class="block text-sm text-muted">SDG</a><a href="#join" class="block text-sm text-muted">Join</a>
  </div>
</nav>

<script>
// NAV scroll
const nav = document.getElementById('nav');
window.addEventListener('scroll', () => {
  if (window.scrollY > 80) nav.classList.add('scrolled');
  else nav.classList.remove('scrolled');
});

// Mobile menu close on link click
document.querySelectorAll('#mobile-menu a').forEach(a => {
  a.addEventListener('click', () => document.getElementById('mobile-menu').classList.add('hidden'));
});

// Reveal observer
const revealEls = document.querySelectorAll('.reveal');
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
revealEls.forEach(el => obs.observe(el));

// Enter overlay — hero canvas (disabled in v0.6)
(function initHeroCanvas() {
  const canvas = document.getElementById('hero-canvas'); if (!canvas) return;
  const ctx = canvas.getContext('2d'); let w = 0, h = 0, mouseX = -1000, mouseY = -1000, mt = 0, ct = 0;
  const waves = [];
  function resize() { const p = canvas.parentElement; if (!p) return; const r = p.getBoundingClientRect(), d = window.devicePixelRatio || 1; w = canvas.width = r.width * d; h = canvas.height = r.height * d; canvas.style.width = r.width + 'px'; canvas.style.height = r.height + 'px'; }
  resize(); window.addEventListener('resize', resize);
  canvas.parentElement.addEventListener('mousemove', function(e) { const r = canvas.getBoundingClientRect(); mouseX = (e.clientX - r.left) * (window.devicePixelRatio || 1); mouseY = (e.clientY - r.top) * (window.devicePixelRatio || 1); });
  function sw(x, y, i) { i = i || 1; if (w === 0 || h === 0) return; for (let j = 0; j < 3; j++) { waves.push({ x, y, r: 1, maxR: (180 + Math.random() * 120) * i, speed: 1.0 + Math.random() * 0.5, opacity: (0.25 + Math.random() * 0.15) * i, delay: j * 0.3, age: 0 }); } if (waves.length > 45) waves.splice(0, waves.length - 45); }
  function si() { if (w > 0 && h > 0) sw(w / 2, h / 2, 1.2); else setTimeout(si, 50); } si();
  function draw() {
    ctx.clearRect(0, 0, w, h); ct += 0.016; if (ct > 1.5) { ct = 0; sw(w / 2, h / 2, 0.8 + Math.random() * 0.4); }
    if (mouseX > 0 && mouseY > 0 && mouseX < w && mouseY < h) { mt += 0.016; if (mt > 1.5) { mt = 0; sw(mouseX, mouseY, 0.6 + Math.random() * 0.3); } } else { mt = 0; }
    for (let i = waves.length - 1; i >= 0; i--) { const wa = waves[i]; wa.age += 0.016; if (wa.age < wa.delay) continue; wa.r = Math.max(2, (wa.age - wa.delay) * wa.speed * 60); if (wa.r > wa.maxR) { waves.splice(i, 1); continue; } const p = wa.r / wa.maxR, f = wa.opacity * (1 - p) * (1 - p); ctx.beginPath(); ctx.arc(wa.x, wa.y, wa.r, 0, Math.PI * 2); ctx.strokeStyle = `rgba(57, 181, 255, ${f})`; ctx.lineWidth = Math.max(0.5, 2.5 * (1 - p * 0.6)); ctx.stroke(); if (wa.r > 4) { try { const g = ctx.createRadialGradient(wa.x, wa.y, wa.r * 0.2, wa.x, wa.y, wa.r); g.addColorStop(0, 'rgba(57, 181, 255, 0)'); g.addColorStop(0.4, `rgba(57, 181, 255, ${f * 0.25})`); g.addColorStop(1, 'rgba(57, 181, 255, 0)'); ctx.fillStyle = g; ctx.beginPath(); ctx.arc(wa.x, wa.y, wa.r, 0, Math.PI * 2); ctx.fill(); } catch(e) {} } }
    requestAnimationFrame(draw);
  }
  draw();
})();

// Enter overlay canvas
(function initEnterCanvas() {
  const canvas = document.getElementById('enter-canvas'); const ctx = canvas.getContext('2d');
  let w, h, mx = -1000, my = -1000;
  function resize() { w = canvas.width = window.innerWidth; h = canvas.height = window.innerHeight; }
  resize(); window.addEventListener('resize', resize); document.addEventListener('mousemove', function(e) { mx = e.clientX; my = e.clientY; });
  const dots = []; for (let i = 0; i < 80; i++) { dots.push({ x: Math.random()*w, y: Math.random()*h, vx: (Math.random()-0.5)*0.4, vy: (Math.random()-0.5)*0.4-0.15, r: 1.5+Math.random()*2.5, opacity: 0.3+Math.random()*0.5, pulse: Math.random()*Math.PI*2 }); }
  const ripples = []; let rt = 0, crt = 0;
  function sr(x, y, i) {
    i = i || 1;
    const isLargeWave = i >= 3;
    const maxR = isLargeWave ? Math.max(w, h) * (0.25 + Math.min(i, 6) * 0.06) : (120 + Math.random() * 80) * i;
    ripples.push({ x, y, r: 0, maxR, speed: isLargeWave ? 5.0 : 1.05 + Math.random() * 0.25, opacity: Math.min(0.78, 0.4 + Math.random() * 0.15 * i), intensity: i, heavy: isLargeWave });
    if (ripples.length > 30) ripples.shift();
  }
  window.__enterCanvas = { spawnRipple: sr };
  function spawnCursorWaveGroup(x, y) { [0.85, 1.0, 1.15].forEach((intensity, index) => { setTimeout(() => sr(x, y, intensity), index * 350); }); }
  function draw() {
    ctx.clearRect(0,0,w,h); ctx.fillStyle='#f5f7f0'; ctx.fillRect(0,0,w,h);
    const g=ctx.createRadialGradient(w/2,h/2,0,w/2,h/2,Math.max(w,h)*0.6);
    g.addColorStop(0,'rgba(143,195,31,0.03)'); g.addColorStop(1,'rgba(143,195,31,0)'); ctx.fillStyle=g; ctx.fillRect(0,0,w,h);
    ctx.strokeStyle='rgba(143,195,31,0.03)'; ctx.lineWidth=1; for(let x=0;x<w;x+=60){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,h);ctx.stroke();} for(let y=0;y<h;y+=60){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke();}
    dots.forEach(d=>{d.x+=d.vx;d.y+=d.vy;d.pulse+=0.025;if(d.x<-10)d.x=w+10;if(d.x>w+10)d.x=-10;if(d.y<-10)d.y=h+10;if(d.y>h+10)d.y=-10;const po=d.opacity*(0.6+0.4*Math.sin(d.pulse));const gl=ctx.createRadialGradient(d.x,d.y,0,d.x,d.y,d.r*5);gl.addColorStop(0,`rgba(143,195,31,${po*0.5})`);gl.addColorStop(1,'rgba(143,195,31,0)');ctx.fillStyle=gl;ctx.beginPath();ctx.arc(d.x,d.y,d.r*5,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(d.x,d.y,d.r,0,Math.PI*2);ctx.fillStyle=`rgba(143,195,31,${po})`;ctx.fill();});
    crt+=0.016; if(crt>1.5){crt=0;sr(w/2,h/2,0.6+Math.random()*0.3);}
    rt+=0.016; if(mx>0&&my>0&&mx<w&&my<h&&rt>2.5){rt=0;spawnCursorWaveGroup(mx,my);}
    ripples.forEach((r,i)=>{
      r.r += r.speed;
      if (r.r > r.maxR) { ripples.splice(i, 1); return; }
      const p = r.r / r.maxR;
      const fade = r.heavy ? (1-p) : (1-p) * (1-p);
      const f = r.opacity * fade;
      ctx.beginPath(); ctx.arc(r.x,r.y,r.r,0,Math.PI*2);
      ctx.strokeStyle = `rgba(69,196,166,${f})`;
      ctx.lineWidth = (r.heavy ? 4 : 2) * (1-p*0.65);
      ctx.stroke();
      const gl=ctx.createRadialGradient(r.x,r.y,r.r*0.35,r.x,r.y,r.r);
      gl.addColorStop(0,'rgba(69,196,166,0)');
      gl.addColorStop(0.5,`rgba(69,196,166,${f*(r.heavy ? 0.3 : 0.2)})`);
      gl.addColorStop(1,'rgba(69,196,166,0)');
      ctx.fillStyle=gl; ctx.beginPath(); ctx.arc(r.x,r.y,r.r,0,Math.PI*2); ctx.fill();
      if (r.heavy && r.r > 24) {
        const secondaryR = r.r * 0.62;
        const secondaryP = secondaryR / r.maxR;
        const secondaryF = r.opacity * 0.55 * (1-secondaryP);
        ctx.beginPath(); ctx.arc(r.x,r.y,secondaryR,0,Math.PI*2);
        ctx.strokeStyle = `rgba(69,196,166,${secondaryF})`;
        ctx.lineWidth = 2.5 * (1-secondaryP);
        ctx.stroke();
      }
    });
    requestAnimationFrame(draw);
  }
  draw();
})();

// Enter wave track canvas
(function initWaveTrack() {
  const canvas = document.getElementById('enter-wave-canvas'); if (!canvas) return;
  const ctx = canvas.getContext('2d'); let w, h, phase = 0;
  function resize() { const r = canvas.parentElement.getBoundingClientRect(); w = canvas.width = r.width; h = canvas.height = r.height; }
  resize(); window.addEventListener('resize', resize);
  const signalColor = (progress, alpha) => {
    const red = Math.round(143 + (57 - 143) * progress);
    const green = Math.round(195 + (181 - 195) * progress);
    const blue = Math.round(31 + (255 - 31) * progress);
    return `rgba(${red},${green},${blue},${alpha})`;
  };
  function draw() {
    ctx.clearRect(0, 0, w, h); phase += 0.02;
    const cy = h / 2;
    const track = (progress, waveIndex) => {
      const waveOffset = waveIndex === 0 ? -9 : 9;
      return cy + waveOffset + Math.sin(progress * Math.PI * 3 + phase * 1.2 + waveIndex) * 7;
    };
    for (let waveIndex = 0; waveIndex < 2; waveIndex++) {
      ctx.beginPath();
      for (let x = 0; x <= w; x += 3) {
        const pointY = track(x / w, waveIndex);
        if (x === 0) ctx.moveTo(x, pointY); else ctx.lineTo(x, pointY);
      }
      const opacity = 0.36 + 0.08 * Math.sin(phase + waveIndex * 1.4);
      const trackGradient = ctx.createLinearGradient(0, 0, w, 0);
      trackGradient.addColorStop(0, 'rgba(143,195,31,0.4)');
      trackGradient.addColorStop(0.5, 'rgba(69,196,166,0.42)');
      trackGradient.addColorStop(1, 'rgba(57,181,255,0.4)');
      ctx.strokeStyle = trackGradient;
      ctx.lineWidth = 2.2;
      ctx.shadowColor = 'rgba(69,196,166, 0.42)';
      ctx.shadowBlur = 7;
      ctx.stroke();
      ctx.shadowBlur = 0;
    }
    for (let pulseIndex = 0; pulseIndex < 3; pulseIndex++) {
      const progress = (phase * 0.24 + pulseIndex / 3) % 1;
      for (let trailStep = 0; trailStep < 10; trailStep++) {
        const trailProgress = Math.max(0, progress - trailStep * 0.012);
        const waveIndex = trailStep % 2;
        const x = trailProgress * w;
        const y = track(trailProgress, waveIndex);
        const life = 1 - trailStep / 10;
        ctx.beginPath();
        ctx.arc(x, y, trailStep === 0 ? 3.2 : 2.4 * life, 0, Math.PI * 2);
        ctx.fillStyle = signalColor(trailProgress, trailStep === 0 ? 0.72 : 0.42 * life);
        ctx.fill();
      }
    }
    [0, 1].forEach(endpoint => {
      const x = endpoint ? w - 2 : 2;
      const y = cy + (endpoint ? 9 : -9);
      ctx.beginPath();
      ctx.arc(x, y, 3.4, 0, Math.PI * 2);
      ctx.fillStyle = endpoint ? 'rgba(57,181,255,0.68)' : 'rgba(143,195,31,0.68)';
      ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  draw();
})();

(function(){
  const c=document.getElementById('honeyguide-cursor'),o=document.getElementById('enter-overlay');
  let cx=-1000,cy=-1000;
  document.addEventListener('mousemove',function(e){cx=e.clientX;cy=e.clientY;});
  function followCursor(){
    if(!o.classList.contains('hidden')&&cx>-500){
      c.style.display='block';c.style.left=cx+'px';c.style.top=cy+'px';
    }
    requestAnimationFrame(followCursor);
  }
  followCursor();
  document.addEventListener('mouseleave',()=>c.style.display='none');
  document.addEventListener('mouseenter',()=>{if(!o.classList.contains('hidden'))c.style.display='block';});
})();

document.getElementById('enter-btn').addEventListener('click',function(e){
  const o=document.getElementById('enter-overlay');
  const rect=document.getElementById('enter-canvas').getBoundingClientRect();
  const cx=e.clientX-rect.left, cy=e.clientY-rect.top;
  o.style.pointerEvents='none';
  document.body.style.cursor='default';
  document.getElementById('honeyguide-cursor').classList.add('hidden');
  if(window.__enterCanvas){
    window.__enterCanvas.spawnRipple(cx,cy,6.0);
    setTimeout(()=>window.__enterCanvas.spawnRipple(cx,cy,5.0),400);
    setTimeout(()=>window.__enterCanvas.spawnRipple(cx,cy,3.0),800);
  }
  setTimeout(()=>o.classList.add('hidden'),1000);
  setTimeout(()=>window.dispatchEvent(new Event('resize')),2200);
});
</script>
