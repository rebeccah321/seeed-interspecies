---
import { Image } from 'astro:assets';
import { HERO_IMAGE } from '../data/images.js';
import { getUI } from '../i18n/ui.js';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const ui = getUI(locale);
const p = ui.prologue;
---

<!-- ============ 01 / PROLOGUE ============ -->
<section id="prologue">
  <div class="hero-frame field-photo-frame">
    <Image
      src={HERO_IMAGE}
      alt={locale === 'zh' ? '暮色中的响蜜鴷' : 'A honeyguide bird perched in golden evening light'}
      widths={[1080, 1920, 2560]}
      sizes="100vw"
      quality={70}
      loading="eager"
      fetchpriority="high"
      data-parallax="hero"
      class="hero-img"
    />
    <div class="grain" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-grid-wrap">
      <div class="hero-content">
        <div class="telemetry-pill" data-rise>
          <span class="pulse-dot" aria-hidden="true"></span>
          <span class="telemetry-text">{p.signal}</span>
        </div>
        <h1 data-rise>{p.title[0]}<br />{p.title[1]}</h1>
        <p class="epigraph" data-rise>{p.epigraph}</p>
        <canvas id="prologue-wave" data-rise aria-hidden="true"></canvas>
      </div>
    </div>
    <a href="#essay" class="scroll-cue" aria-label={p.scroll}>
      <span>{p.scroll}</span>
      <span class="cue-line" aria-hidden="true"></span>
    </a>
  </div>

  <div class="essay" id="essay">
    <header class="essay-head reveal">
      <p class="telemetry"><span class="dot"></span>{p.head}</p>
    </header>

    <div class="essay-story reveal">
      <p class="lead">{p.leadBefore}<em>{p.honeyguide}</em>{p.leadAfter}</p>
      <p>{p.s1}</p>
      <p>{p.s2}</p>
    </div>

    <div class="beats">
      {p.beats.map((b) => (
        <div class="beat reveal">
          <span class="beat-n">{b.n}</span>
          <h3>{b.h}</h3>
          <p>{b.p}</p>
        </div>
      ))}
    </div>

    <aside class="footnote reveal">
      <p><span class="fn-n">1</span>{p.footnote}</p>
    </aside>
  </div>
</section>

<style>
  .hero-frame {
    position: relative;
    height: 100dvh;
    min-height: 560px;
    border-radius: 0;
    border: none;
  }

  @supports not (height: 100dvh) {
    .hero-frame { height: 100vh; }
  }

  .hero-frame :global(img) {
    width: 100%;
    height: 100%;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(to top, rgba(12, 19, 16, 0.92) 0%, rgba(12, 19, 16, 0.25) 35%, transparent 65%, rgba(12, 19, 16, 0.25) 100%),
      linear-gradient(to left, rgba(12, 19, 16, 0.82) 0%, rgba(12, 19, 16, 0.38) 46%, transparent 76%);
  }

  .hero-grid-wrap {
    position: absolute;
    inset: 0;
    z-index: 4;
    max-width: 76rem;
    margin: 0 auto;
    padding: 6rem 1.5rem 2rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    pointer-events: none;
  }

  .hero-content {
    max-width: 38rem;
    width: 100%;
    pointer-events: auto;
    margin-top: -6vh;
  }

  .telemetry-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(12, 19, 16, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(130, 195, 65, 0.32);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    margin-bottom: 0.75rem;
  }

  .telemetry-pill .pulse-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-seeed);
    box-shadow: 0 0 10px rgba(130, 195, 65, 0.9);
  }

  .telemetry-pill .telemetry-text {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-bone);
    font-weight: 500;
  }

  .hero-content h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.4rem, 4.4vw, 4.1rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--color-bone);
    margin: 0.75rem 0 1.25rem;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.6);
  }

  .epigraph {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.25vw, 1.15rem);
    line-height: 1.65;
    color: var(--color-pith);
    max-width: 34rem;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.6);
  }

  #prologue-wave {
    display: block;
    width: 320px;
    max-width: 70vw;
    height: 44px;
    margin-top: 1.75rem;
    opacity: 0.85;
  }

  .scroll-cue {
    position: absolute;
    z-index: 4;
    bottom: 4vh;
    right: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-fog);
    transition: color 0.3s;
  }

  .scroll-cue:hover { color: var(--color-bone); }

  .cue-line {
    display: block;
    width: 1px;
    height: 34px;
    background: linear-gradient(to bottom, var(--color-fog), transparent);
  }

  /* ---- Essay ---- */
  .essay {
    max-width: 44rem;
    margin: 0 auto;
    padding: 9rem 1.5rem 4rem;
  }

  .essay-story .lead {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.65;
    color: var(--color-bone);
    margin-bottom: 1.75rem;
  }

  .essay-story .lead em { color: var(--color-lichen); }

  .essay-story p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-pith);
    margin-bottom: 1.25rem;
  }

  .essay-story sup {
    font-family: var(--font-mono);
    font-size: 0.65em;
    color: var(--color-lichen);
  }

  .beats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 3.5rem;
    margin-top: 5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--color-line);
  }

  .beat { padding: 1.5rem 0 2.25rem; border-bottom: 1px solid var(--color-line); }

  .beat-n {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    color: var(--color-lichen);
  }

  .beat h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.35;
    color: var(--color-bone);
    margin: 0.65rem 0 0.6rem;
  }

  .beat p {
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--color-pith);
  }

  .footnote {
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .footnote p {
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--color-fog);
  }

  .footnote .fn-n {
    font-family: var(--font-mono);
    color: var(--color-lichen);
    margin-right: 0.6em;
  }

  @media (max-width: 768px) {
    .hero-grid-wrap {
      justify-content: flex-start;
      padding-bottom: 9vh;
    }
    .beats { grid-template-columns: 1fr; gap: 0; }
    .essay { padding-top: 6rem; }
    .scroll-cue { right: 1.25rem; }
  }
</style>
