---
const base = import.meta.env.BASE_URL;
---

<!-- ============ PEOPLE ============ -->
<section id="partners" class="py-16" style="background:#f5f9f1">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-10 reveal">
      <div class="text-xs font-semibold tracking-[2px] uppercase text-brand-deep mb-3" data-en="Who We Work With" data-zh="合作伙伴">Who We Work With</div>
      <h2 class="font-display text-2xl md:text-4xl font-bold mb-3" data-en="People &amp; Partners" data-zh="人与伙伴">People &amp; Partners</h2>
    </div>
    <div class="grid md:grid-cols-4 gap-4 mb-8">
      <div class="partner-card rounded-xl p-5 text-center reveal hover:shadow-card-hover transition-shadow">
        <div class="partner-logo"><img src={`${base}/partner-logos/mit-media-lab.svg`} alt="MIT Media Lab logo"></div>
        <h3 class="font-display font-bold text-sm">MIT Media Lab</h3>
        <p class="text-xs text-muted mt-1" data-en="Pioneering the Fab Lab network and Interspecies Internet initiative." data-zh="开创 Fab Lab 网络与跨物种互联网倡议。">Pioneering the Fab Lab network and Interspecies Internet initiative.</p>
      </div>
      <div class="partner-card rounded-xl p-5 text-center reveal hover:shadow-card-hover transition-shadow">
        <div class="partner-logo square"><img src={`${base}/partner-logos/interspecies-internet.png`} alt="Interspecies Internet logo"></div>
        <h3 class="font-display font-bold text-sm">Interspecies Internet</h3>
        <p class="text-xs text-muted mt-1" data-en="A nonprofit advancing the research and ethics of interspecies communication, with Seeed as its hardware partner." data-zh="推动跨物种交流研究与伦理的非营利组织，Seeed 是其硬件合作伙伴。">A nonprofit advancing the research and ethics of interspecies communication, with Seeed as its hardware partner.</p>
      </div>
      <div class="partner-card rounded-xl p-5 text-center reveal hover:shadow-card-hover transition-shadow">
        <div class="partner-logo"><img src={`${base}/partner-logos/fab-lab-network.svg`} alt="Fab Lab Network logo"></div>
        <h3 class="font-display font-bold text-sm">Fab Lab Network</h3>
        <p class="text-xs text-muted mt-1" data-en="Global network of digital fabrication laboratories." data-zh="全球数制制造实验室网络。">Global network of digital fabrication laboratories.</p>
      </div>
      <div class="partner-card rounded-xl p-5 text-center reveal hover:shadow-card-hover transition-shadow">
        <div class="partner-logo square"><img src={`${base}/partner-logos/dina-lab.png`} alt="Dina Lab logo"></div>
        <h3 class="font-display font-bold text-sm">Dina Lab</h3>
        <p class="text-xs text-muted mt-1" data-en="Creator of the Mothbox open-source insect trap cam." data-zh="Mothbox 开源昆虫诱捕摄像头创建者。">Creator of the Mothbox open-source insect trap cam.</p>
      </div>
    </div>
  </div>
</section>
