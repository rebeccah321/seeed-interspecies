---
const base = import.meta.env.BASE_URL;
const cardBg = [
  `linear-gradient(to bottom,transparent 0%,transparent 45%,rgba(255,255,255,.85) 80%,#fff 100%), url('${base}/images/card-1-identification.png')`,
  `linear-gradient(to bottom,transparent 0%,transparent 45%,rgba(255,255,255,.85) 80%,#fff 100%), url('${base}/images/card-2-population.png')`,
  `linear-gradient(to bottom,transparent 0%,transparent 45%,rgba(255,255,255,.85) 80%,#fff 100%), url('${base}/images/card-3-cognitive.png')`,
  `linear-gradient(to bottom,transparent 0%,transparent 45%,rgba(255,255,255,.85) 80%,#fff 100%), url('${base}/images/card-4-acoustic.png')`,
  `linear-gradient(to bottom,transparent 0%,transparent 45%,rgba(255,255,255,.85) 80%,#fff 100%), url('${base}/images/card-5-social.png')`,
  `linear-gradient(to bottom,transparent 0%,transparent 45%,rgba(255,255,255,.85) 80%,#fff 100%), url('${base}/images/card-6-habitat.png')`,
];
---

<!-- ============ WHAT ============ -->
<section id="what" class="py-16" style="background:#f1f7ea">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-10 reveal">
      <div class="text-xs font-semibold tracking-[2px] uppercase text-brand-deep mb-3">What We Do</div>
      <h2 class="font-display text-2xl md:text-4xl font-bold mb-3">Fieldwork to Frontier — Six Domains, One Stack</h2>
      <p class="text-muted max-w-3xl mx-auto text-sm">From traditional field methods to AI-powered sensing — the full landscape of animal research, and where open hardware changes what's possible.</p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="sdg-card research-card hover-gloss bg-white border border-line rounded-xl reveal">
        <div class="research-card-img" style={`background-image:${cardBg[0]}`}></div>
        <div class="card-body">
        <div class="w-10 h-10 rounded-xl bg-brand-light flex items-center justify-center mb-3"><svg class="w-5 h-5 text-brand-deep" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div>
        <h3 class="font-display font-bold text-sm mb-2">Individual Identification &amp; Lifecycle Tracking</h3>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-2 mb-2"><p class="text-xs text-amber-800 font-medium">Traditional Fieldwork</p><p class="text-xs text-ink/70">Mark-recapture, photo ID, GPS collars — invasive, expensive.</p></div>
        <div class="bg-brand-light border border-brand/20 rounded-lg p-2 mb-3"><p class="text-xs text-brand-deep font-medium">AI-Powered</p><p class="text-xs text-ink/70">AI reads natural markings — tiger stripes, fin notches — like barcodes.</p></div>
        <div class="flex flex-wrap gap-1"><span class="tech-tag bg-brand/15 text-brand-deep">CV</span><span class="tech-tag bg-brand/15 text-brand-deep">Edge AI</span></div>
        </div>
      </div>
      <div class="sdg-card research-card hover-gloss bg-white border border-line rounded-xl reveal">
        <div class="research-card-img" style={`background-image:${cardBg[1]}`}></div>
        <div class="card-body">
        <div class="w-10 h-10 rounded-xl bg-brand-light flex items-center justify-center mb-3"><svg class="w-5 h-5 text-brand-deep" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
        <h3 class="font-display font-bold text-sm mb-2">Population Counting &amp; Dynamics</h3>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-2 mb-2"><p class="text-xs text-amber-800 font-medium">Traditional Fieldwork</p><p class="text-xs text-ink/70">Camera traps + manual review. A single estimate takes weeks.</p></div>
        <div class="bg-brand-light border border-brand/20 rounded-lg p-2 mb-3"><p class="text-xs text-brand-deep font-medium">AI-Powered</p><p class="text-xs text-ink/70">On-device AI identifies and counts species automatically.</p></div>
        <div class="flex flex-wrap gap-1"><span class="tech-tag bg-brand/15 text-brand-deep">CV</span><span class="tech-tag bg-brand/15 text-brand-deep">LoRa</span></div>
        </div>
      </div>
      <div class="sdg-card research-card hover-gloss bg-white border border-line rounded-xl reveal">
        <div class="research-card-img" style={`background-image:${cardBg[2]}`}></div>
        <div class="card-body">
        <div class="w-10 h-10 rounded-xl bg-brand-light flex items-center justify-center mb-3"><svg class="w-5 h-5 text-brand-deep" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div>
        <h3 class="font-display font-bold text-sm mb-2">Cognitive Decline &amp; Aging Research</h3>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-2 mb-2"><p class="text-xs text-amber-800 font-medium">Traditional Fieldwork</p><p class="text-xs text-ink/70">Manual ethogram coding — short, subjective, expert-dependent.</p></div>
        <div class="bg-brand-light border border-brand/20 rounded-lg p-2 mb-3"><p class="text-xs text-brand-deep font-medium">AI-Powered</p><p class="text-xs text-ink/70">24/7 gait and vocal monitoring. VLM detects changes early.</p></div>
        <div class="flex flex-wrap gap-1"><span class="tech-tag bg-brand/15 text-brand-deep">CV</span><span class="tech-tag bg-brand/15 text-brand-deep">VLM</span><span class="tech-tag bg-brand/15 text-brand-deep">STT</span></div>
        </div>
      </div>
      <div class="sdg-card research-card hover-gloss bg-white border border-line rounded-xl reveal">
        <div class="research-card-img" style={`background-image:${cardBg[3]}`}></div>
        <div class="card-body">
        <div class="w-10 h-10 rounded-xl bg-brand-light flex items-center justify-center mb-3"><svg class="w-5 h-5 text-brand-deep" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="M19 12a4 4 0 0 0-2-3.5"/><path d="M22 12a8 8 0 0 0-4-7"/></svg></div>
        <h3 class="font-display font-bold text-sm mb-2">Acoustic Monitoring</h3>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-2 mb-2"><p class="text-xs text-amber-800 font-medium">Traditional Fieldwork</p><p class="text-xs text-ink/70">Record + send to experts. Expensive, slow.</p></div>
        <div class="bg-brand-light border border-brand/20 rounded-lg p-2 mb-3"><p class="text-xs text-brand-deep font-medium">AI-Powered</p><p class="text-xs text-ink/70">Edge-based sound classification identifies species automatically.</p></div>
        <div class="flex flex-wrap gap-1"><span class="tech-tag bg-brand/15 text-brand-deep">STT</span><span class="tech-tag bg-brand/15 text-brand-deep">Audio AI</span></div>
        </div>
      </div>
      <div class="sdg-card research-card hover-gloss bg-white border border-line rounded-xl reveal">
        <div class="research-card-img" style={`background-image:${cardBg[4]}`}></div>
        <div class="card-body">
        <div class="w-10 h-10 rounded-xl bg-brand-light flex items-center justify-center mb-3"><svg class="w-5 h-5 text-brand-deep" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg></div>
        <h3 class="font-display font-bold text-sm mb-2">Social Behavior &amp; Group Dynamics</h3>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-2 mb-2"><p class="text-xs text-amber-800 font-medium">Traditional Fieldwork</p><p class="text-xs text-ink/70">Years of focal observation. Patterns take seasons to spot.</p></div>
        <div class="bg-brand-light border border-brand/20 rounded-lg p-2 mb-3"><p class="text-xs text-brand-deep font-medium">AI-Powered</p><p class="text-xs text-ink/70">Multi-camera arrays map interactions in real time.</p></div>
        <div class="flex flex-wrap gap-1"><span class="tech-tag bg-brand/15 text-brand-deep">CV</span><span class="tech-tag bg-brand/15 text-brand-deep">Multi-modal</span></div>
        </div>
      </div>
      <div class="sdg-card research-card hover-gloss bg-white border border-line rounded-xl reveal">
        <div class="research-card-img" style={`background-image:${cardBg[5]}`}></div>
        <div class="card-body">
        <div class="w-10 h-10 rounded-xl bg-brand-light flex items-center justify-center mb-3"><svg class="w-5 h-5 text-brand-deep" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M2 22V8l6-4 6 4v14"/><path d="M2 14h12"/><path d="M10 22V10"/><path d="M18 22V6l4-2v18"/></svg></div>
        <h3 class="font-display font-bold text-sm mb-2">Habitat &amp; Carrying Capacity Monitoring</h3>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-2 mb-2"><p class="text-xs text-amber-800 font-medium">Traditional Fieldwork</p><p class="text-xs text-ink/70">Periodic sampling + lab analysis. You miss almost everything.</p></div>
        <div class="bg-brand-light border border-brand/20 rounded-lg p-2 mb-3"><p class="text-xs text-brand-deep font-medium">AI-Powered</p><p class="text-xs text-ink/70">Continuous sensors report daily. Restoration becomes watchable.</p></div>
        <div class="flex flex-wrap gap-1"><span class="tech-tag bg-brand/15 text-brand-deep">Environmental Sensors</span><span class="tech-tag bg-brand/15 text-brand-deep">IoT</span></div>
        </div>
      </div>
    </div>
  </div>
</section>
