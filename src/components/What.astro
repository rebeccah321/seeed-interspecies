---
const base = import.meta.env.BASE_URL;
const cardBg = [
  `url('${base}/images/card-1-identification.png')`,
  `url('${base}/images/card-2-population.png')`,
  `url('${base}/images/card-3-cognitive.png')`,
  `url('${base}/images/card-4-acoustic.png')`,
  `url('${base}/images/card-5-social.png')`,
  `url('${base}/images/card-6-habitat.png')`,
];
---

<!-- ============ WHAT ============ -->
<section id="what" class="py-16" style="background:#f1f7ea">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-10 reveal">
      <div class="text-xs font-semibold tracking-[2px] uppercase text-brand-deep mb-3"><span data-en="What We Do" data-zh="我们做什么">What We Do</span></div>
      <h2 class="font-display text-2xl md:text-4xl font-bold mb-3"><span data-en="Fieldwork to Frontier — Six Domains, One Stack" data-zh="从田野到前沿 — 六大领域，一套技术体系">Fieldwork to Frontier — Six Domains, One Stack</span></h2>
      <p class="text-muted max-w-3xl mx-auto text-sm"><span data-en="From traditional field methods to AI-powered sensing — the full landscape of animal research, and where open hardware changes what's possible." data-zh="从传统田野方法到 AI 驱动的感知能力——动物研究的完整图景，以及开源硬件如何拓展可能性。">From traditional field methods to AI-powered sensing — the full landscape of animal research, and where open hardware changes what's possible.</span></p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      <div id="domain-1" class="sdg-card research-card hover-gloss bg-white border border-line rounded-xl reveal">
        <div class="research-card-img" style={`background-image:${cardBg[0]}`}></div>
        <div class="card-body">
        <div class="w-10 h-10 rounded-xl bg-brand-light flex items-center justify-center mb-3"><svg class="w-5 h-5 text-brand-deep" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div>
        <h3 class="font-display font-bold text-sm mb-2" data-en="Individual Identification &amp; Lifecycle Tracking" data-zh="个体识别与生命周期监测">Individual Identification &amp; Lifecycle Tracking</h3>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-2 mb-2"><p class="text-xs text-amber-800 font-medium" data-en="Traditional Fieldwork" data-zh="传统田野工作">Traditional Fieldwork</p><p class="text-xs text-ink/70" data-en="Mark-recapture, photo ID, GPS collars — invasive, expensive." data-zh="标记重捕、照片鉴定、GPS 项圈——侵入性强、成本高。">Mark-recapture, photo ID, GPS collars — invasive, expensive.</p></div>
        <div class="bg-brand-light border border-brand/20 rounded-lg p-2 mb-3"><p class="text-xs text-brand-deep font-medium" data-en="AI-Powered" data-zh="AI 驱动">AI-Powered</p><p class="text-xs text-ink/70" data-en="AI reads natural markings — tiger stripes, fin notches — like barcodes." data-zh="AI 读取天然体纹——虎纹、鳍缺刻——如同扫码。">AI reads natural markings — tiger stripes, fin notches — like barcodes.</p></div>
        <div class="flex flex-wrap gap-1"><span class="tech-tag bg-brand/15 text-brand-deep">CV</span><span class="tech-tag bg-brand/15 text-brand-deep">Edge AI</span></div>
        </div>
      </div>
      <div id="domain-2" class="sdg-card research-card hover-gloss bg-white border border-line rounded-xl reveal">
        <div class="research-card-img" style={`background-image:${cardBg[1]}`}></div>
        <div class="card-body">
        <div class="w-10 h-10 rounded-xl bg-brand-light flex items-center justify-center mb-3"><svg class="w-5 h-5 text-brand-deep" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
        <h3 class="font-display font-bold text-sm mb-2" data-en="Population Counting &amp; Dynamics" data-zh="种群调查与动态变化">Population Counting &amp; Dynamics</h3>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-2 mb-2"><p class="text-xs text-amber-800 font-medium" data-en="Traditional Fieldwork" data-zh="传统田野工作">Traditional Fieldwork</p><p class="text-xs text-ink/70" data-en="Camera traps + manual review. A single estimate takes weeks." data-zh="红外相机+人工判读。单次估算需数周。">Camera traps + manual review. A single estimate takes weeks.</p></div>
        <div class="bg-brand-light border border-brand/20 rounded-lg p-2 mb-3"><p class="text-xs text-brand-deep font-medium" data-en="AI-Powered" data-zh="AI 驱动">AI-Powered</p><p class="text-xs text-ink/70" data-en="On-device AI identifies and counts species automatically." data-zh="端侧 AI 自动识别并统计物种。">On-device AI identifies and counts species automatically.</p></div>
        <div class="flex flex-wrap gap-1"><span class="tech-tag bg-brand/15 text-brand-deep">CV</span><span class="tech-tag bg-brand/15 text-brand-deep">LoRa</span></div>
        </div>
      </div>
      <div id="domain-3" class="sdg-card research-card hover-gloss bg-white border border-line rounded-xl reveal">
        <div class="research-card-img" style={`background-image:${cardBg[2]}`}></div>
        <div class="card-body">
        <div class="w-10 h-10 rounded-xl bg-brand-light flex items-center justify-center mb-3"><svg class="w-5 h-5 text-brand-deep" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div>
        <h3 class="font-display font-bold text-sm mb-2" data-en="Cognitive Decline &amp; Aging Research" data-zh="认知衰退与衰老研究">Cognitive Decline &amp; Aging Research</h3>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-2 mb-2"><p class="text-xs text-amber-800 font-medium" data-en="Traditional Fieldwork" data-zh="传统田野工作">Traditional Fieldwork</p><p class="text-xs text-ink/70" data-en="Manual ethogram coding — short, subjective, expert-dependent." data-zh="人工行为谱记录——观察期短、主观性强、依赖专家经验。">Manual ethogram coding — short, subjective, expert-dependent.</p></div>
        <div class="bg-brand-light border border-brand/20 rounded-lg p-2 mb-3"><p class="text-xs text-brand-deep font-medium" data-en="AI-Powered" data-zh="AI 驱动">AI-Powered</p><p class="text-xs text-ink/70" data-en="24/7 gait and vocal monitoring. VLM detects changes early." data-zh="全天候步态与发声监测，VLM 提早发现异常。">24/7 gait and vocal monitoring. VLM detects changes early.</p></div>
        <div class="flex flex-wrap gap-1"><span class="tech-tag bg-brand/15 text-brand-deep">CV</span><span class="tech-tag bg-brand/15 text-brand-deep">VLM</span><span class="tech-tag bg-brand/15 text-brand-deep">STT</span></div>
        </div>
      </div>
      <div id="domain-4" class="sdg-card research-card hover-gloss bg-white border border-line rounded-xl reveal">
        <div class="research-card-img" style={`background-image:${cardBg[3]}`}></div>
        <div class="card-body">
        <div class="w-10 h-10 rounded-xl bg-brand-light flex items-center justify-center mb-3"><svg class="w-5 h-5 text-brand-deep" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="M19 12a4 4 0 0 0-2-3.5"/><path d="M22 12a8 8 0 0 0-4-7"/></svg></div>
        <h3 class="font-display font-bold text-sm mb-2" data-en="Acoustic Monitoring" data-zh="声学监测">Acoustic Monitoring</h3>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-2 mb-2"><p class="text-xs text-amber-800 font-medium" data-en="Traditional Fieldwork" data-zh="传统田野工作">Traditional Fieldwork</p><p class="text-xs text-ink/70" data-en="Record + send to experts. Expensive, slow." data-zh="录制后送交专家分析。成本高、周期长。">Record + send to experts. Expensive, slow.</p></div>
        <div class="bg-brand-light border border-brand/20 rounded-lg p-2 mb-3"><p class="text-xs text-brand-deep font-medium" data-en="AI-Powered" data-zh="AI 驱动">AI-Powered</p><p class="text-xs text-ink/70" data-en="Edge-based sound classification identifies species automatically." data-zh="端侧声学分类，自动识别物种。">Edge-based sound classification identifies species automatically.</p></div>
        <div class="flex flex-wrap gap-1"><span class="tech-tag bg-brand/15 text-brand-deep">STT</span><span class="tech-tag bg-brand/15 text-brand-deep">Audio AI</span></div>
        </div>
      </div>
      <div id="domain-5" class="sdg-card research-card hover-gloss bg-white border border-line rounded-xl reveal">
        <div class="research-card-img" style={`background-image:${cardBg[4]}`}></div>
        <div class="card-body">
        <div class="w-10 h-10 rounded-xl bg-brand-light flex items-center justify-center mb-3"><svg class="w-5 h-5 text-brand-deep" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg></div>
        <h3 class="font-display font-bold text-sm mb-2" data-en="Social Behavior &amp; Group Dynamics" data-zh="社会行为与群体动态">Social Behavior &amp; Group Dynamics</h3>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-2 mb-2"><p class="text-xs text-amber-800 font-medium" data-en="Traditional Fieldwork" data-zh="传统田野工作">Traditional Fieldwork</p><p class="text-xs text-ink/70" data-en="Years of focal observation. Patterns take seasons to spot." data-zh="长年焦点个体观察。行为规律需数季才能浮现。">Years of focal observation. Patterns take seasons to spot.</p></div>
        <div class="bg-brand-light border border-brand/20 rounded-lg p-2 mb-3"><p class="text-xs text-brand-deep font-medium" data-en="AI-Powered" data-zh="AI 驱动">AI-Powered</p><p class="text-xs text-ink/70" data-en="Multi-camera arrays map interactions in real time." data-zh="多相机阵列实时捕捉个体间互动。">Multi-camera arrays map interactions in real time.</p></div>
        <div class="flex flex-wrap gap-1"><span class="tech-tag bg-brand/15 text-brand-deep">CV</span><span class="tech-tag bg-brand/15 text-brand-deep">Multi-modal</span></div>
        </div>
      </div>
      <div id="domain-6" class="sdg-card research-card hover-gloss bg-white border border-line rounded-xl reveal">
        <div class="research-card-img" style={`background-image:${cardBg[5]}`}></div>
        <div class="card-body">
        <div class="w-10 h-10 rounded-xl bg-brand-light flex items-center justify-center mb-3"><svg class="w-5 h-5 text-brand-deep" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M2 22V8l6-4 6 4v14"/><path d="M2 14h12"/><path d="M10 22V10"/><path d="M18 22V6l4-2v18"/></svg></div>
        <h3 class="font-display font-bold text-sm mb-2" data-en="Habitat &amp; Carrying Capacity Monitoring" data-zh="栖息地与承载力监测">Habitat &amp; Carrying Capacity Monitoring</h3>
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-2 mb-2"><p class="text-xs text-amber-800 font-medium" data-en="Traditional Fieldwork" data-zh="传统田野工作">Traditional Fieldwork</p><p class="text-xs text-ink/70" data-en="Periodic sampling + lab analysis. You miss almost everything." data-zh="周期性采样+实验室分析。大量信息被遗漏。">Periodic sampling + lab analysis. You miss almost everything.</p></div>
        <div class="bg-brand-light border border-brand/20 rounded-lg p-2 mb-3"><p class="text-xs text-brand-deep font-medium" data-en="AI-Powered" data-zh="AI 驱动">AI-Powered</p><p class="text-xs text-ink/70" data-en="Continuous sensors report daily. Restoration becomes watchable." data-zh="连续传感器每日回报，生态修复过程可追踪。">Continuous sensors report daily. Restoration becomes watchable.</p></div>
        <div class="flex flex-wrap gap-1"><span class="tech-tag bg-brand/15 text-brand-deep">Environmental Sensors</span><span class="tech-tag bg-brand/15 text-brand-deep">IoT</span></div>
        </div>
      </div>
    </div>
  </div>
</section>
