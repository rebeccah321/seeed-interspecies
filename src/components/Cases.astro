---
const base = import.meta.env.BASE_URL;
---

<!-- ============ EVIDENCE ============ -->
<section id="cases" class="py-16 border-b border-line" style="background:#eaf2f9">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-10 reveal">
      <div class="text-xs font-semibold tracking-[2px] uppercase text-brand-deep mb-3">Evidence</div>
      <h2 class="font-display text-2xl md:text-4xl font-bold mb-3">Deployments in the Wild</h2>
      <p class="text-muted max-w-2xl mx-auto text-sm">Every pin on this map is a real deployment — in the rainforest, the wetland, the mountain range.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2 mb-4 reveal" id="filter-bar">
      <span class="text-xs text-muted mr-1">Filter:</span>
      <button class="filter-btn active pill border border-line px-2.5 py-1 text-xs font-medium text-ink hover:bg-brand/10 hover:border-brand/40" data-filter="all">All</button>
      <button class="filter-btn pill border border-line px-2.5 py-1 text-xs font-medium text-ink hover:bg-brand/10 hover:border-brand/40" data-filter="CV">CV</button>
      <button class="filter-btn pill border border-line px-2.5 py-1 text-xs font-medium text-ink hover:bg-brand/10 hover:border-brand/40" data-filter="LoRa">LoRa</button>
      <button class="filter-btn pill border border-line px-2.5 py-1 text-xs font-medium text-ink hover:bg-brand/10 hover:border-brand/40" data-filter="STT">STT</button>
      <button class="filter-btn pill border border-line px-2.5 py-1 text-xs font-medium text-ink hover:bg-brand/10 hover:border-brand/40" data-filter="VLM">VLM</button>
      <button class="filter-btn pill border border-line px-2.5 py-1 text-xs font-medium text-ink hover:bg-brand/10 hover:border-brand/40" data-filter="Tracker">Tracker</button>
      <button class="filter-btn pill border border-line px-2.5 py-1 text-xs font-medium text-ink hover:bg-brand/10 hover:border-brand/40" data-filter="Environmental">Environmental</button>
    </div>
    <div class="relative mb-4 reveal map-wrapper">
      <div id="world-map"></div>
      <div id="map-canvas-overlay"><canvas id="map-connection-canvas"></canvas></div>
      <div id="map-float-card" class="map-float-card"><div id="map-float-card-body"></div></div>
    </div>
    <!-- Case label + status legend -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 mb-3 reveal">
      <div class="text-sm font-bold tracking-[2px] uppercase text-brand-deep">Case</div>
      <div class="flex items-center gap-4 text-[11px] text-muted">
        <span class="flex items-center gap-1.5"><span class="inline-block w-2 h-2 rounded-full" style="background:#8FC31F;box-shadow:0 0 4px rgba(143,195,31,.5)"></span>Deployed</span>
        <span class="flex items-center gap-1.5"><span class="inline-block w-2 h-2 rounded-full" style="background:#ffab00;box-shadow:0 0 4px rgba(255,171,0,.4)"></span>In Progress</span>
        <span class="flex items-center gap-1.5"><span class="inline-block w-2 h-2 rounded-full" style="background:#aab8ab"></span>Open to Collaborate</span>
      </div>
    </div>
    <div class="carousel-wrap reveal">
      <div class="carousel-row" id="carousel-row-1" style="--fade-from:#eaf2f9"><div class="carousel-fade-left"></div><div class="carousel-fade-right"></div><div class="carousel-track auto-scroll" id="carousel-track-1"></div></div>
      <div class="carousel-row" id="carousel-row-2" style="--fade-from:#eaf2f9"><div class="carousel-fade-left"></div><div class="carousel-fade-right"></div><div class="carousel-track auto-scroll-right" id="carousel-track-2"></div></div>
    </div>
    <div class="case-modal-overlay" id="case-modal">
      <div class="case-modal">        <div class="case-modal-bar"><button class="case-modal-close" id="case-modal-close-btn">✕</button></div>
        <div class="modal-img" id="modal-img"><svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg></div>
        <div class="modal-tags" id="modal-tags"></div><div id="modal-status-badge" class="modal-status-badge"></div><h3 id="modal-title"></h3><p class="modal-meta" id="modal-meta"></p><p class="modal-desc" id="modal-desc"></p>
        <div class="modal-stats" id="modal-stats"></div>
        <a id="modal-cta" class="modal-cta" href="#" target="_blank" rel="noopener">View Full Case<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
    </div>
  </div>
</section>

<script>
import L from 'leaflet';
import 'leaflet/dist/leaflet.css';
import { PROJECTS } from '../data/projects.js';

const base = import.meta.env.BASE_URL;

// Map connection canvas
(function(){
  const c=document.getElementById('map-connection-canvas');if(!c)return;
  const ctx=c.getContext('2d');let w,h;
  const COORDS=[{id:'tnc',lat:22.49,lng:114.05},{id:'bhutan',lat:27.51,lng:90.43},{id:'mothbox-panama',lat:8.98,lng:-79.52},{id:'mothbox-peru',lat:-9.19,lng:-75.02},{id:'mothbox-yellowstone',lat:44.6,lng:-110.5},{id:'olfactory',lat:47.63,lng:-122.33},{id:'collarid',lat:42.36,lng:-71.09},{id:'lifescience',lat:19.08,lng:72.88}];
  function xy(lat,lng){return{x:((lng+180)/360)*w,y:((90-lat)/180)*h};}
  function resize(){const p=c.parentElement.getBoundingClientRect();w=c.width=p.width;h=c.height=p.height;c.style.width=p.width+'px';c.style.height=p.height+'px';}
  resize();window.addEventListener('resize',resize);
  const pairs=[['tnc','bhutan'],['bhutan','mothbox-panama'],['mothbox-panama','mothbox-peru'],['mothbox-panama','mothbox-yellowstone'],['mothbox-yellowstone','collarid'],['collarid','olfactory'],['bhutan','lifescience'],['collarid','tnc']];
  const conns=[];
  pairs.forEach(([a,b])=>{const pa=COORDS.find(p=>p.id===a),pb=COORDS.find(p=>p.id===b);if(pa&&pb)conns.push({from:pa,to:pb});});
  function draw(){ctx.clearRect(0,0,w,h);conns.forEach(c=>{const f=xy(c.from.lat,c.from.lng),t=xy(c.to.lat,c.to.lng);ctx.beginPath();ctx.moveTo(f.x,f.y);ctx.lineTo(t.x,t.y);ctx.strokeStyle='rgba(143,195,31,0.12)';ctx.lineWidth=1;ctx.setLineDash([4,6]);ctx.stroke();ctx.setLineDash([]);});requestAnimationFrame(draw);}
  draw();
})();

(function(){
  const c=document.getElementById('sdg-ring-canvas');if(!c)return;
  const ctx=c.getContext('2d');let w,h;
  function resize(){const r=c.getBoundingClientRect();w=c.width=r.width*(window.devicePixelRatio||1);h=c.height=r.height*(window.devicePixelRatio||1);c.style.width=r.width+'px';c.style.height=r.height+'px';}
  resize();window.addEventListener('resize',resize);
  const cx2=w/2,cy2=h/2,rx=w*0.42,ry=h*0.3;let angle=0;
  function draw(){ctx.clearRect(0,0,w,h);angle+=0.008;ctx.beginPath();ctx.ellipse(cx2,cy2,rx,ry,0,0,Math.PI*2);ctx.strokeStyle='rgba(0,147,109,0.15)';ctx.lineWidth=1.5;ctx.setLineDash([3,6]);ctx.stroke();ctx.setLineDash([]);const dx=cx2+rx*Math.cos(angle),dy=cy2+ry*Math.sin(angle*0.7);const g=ctx.createRadialGradient(dx,dy,0,dx,dy,20);g.addColorStop(0,'rgba(0,147,109,0.4)');g.addColorStop(0.5,'rgba(0,147,109,0.15)');g.addColorStop(1,'rgba(0,147,109,0)');ctx.fillStyle=g;ctx.beginPath();ctx.arc(dx,dy,20,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(dx,dy,3,0,Math.PI*2);ctx.fillStyle='#00936d';ctx.fill();for(let i=1;i<=12;i++){const t=angle-i*0.05,tx=cx2+rx*Math.cos(t),ty=cy2+ry*Math.sin(t*0.7),f=1-i/12;ctx.beginPath();ctx.arc(tx,ty,2*f,0,Math.PI*2);ctx.fillStyle=`rgba(0,147,109,${f*0.3})`;ctx.fill();}for(let i=0;i<8;i++){const a=(i/8)*Math.PI*2,px=cx2+rx*0.92*Math.cos(a),py=cy2+ry*0.92*Math.sin(a*0.7);ctx.beginPath();ctx.arc(px,py,1.5,0,Math.PI*2);ctx.fillStyle='rgba(0,147,109,0.2)';ctx.fill();}requestAnimationFrame(draw);}
  draw();
})();

const worldMap = L.map('world-map', { scrollWheelZoom:false, zoomControl:true, attributionControl:false, worldCopyJump:true, minZoom:2, maxZoom:16, maxBounds:[[-85,-180],[85,180]], maxBoundsViscosity:0.8 }).setView([15,0],2);
L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Ocean/World_Ocean_Base/MapServer/tile/{z}/{y}/{x}', { attribution:'', maxZoom:16 }).addTo(worldMap);
L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Ocean/World_Ocean_Reference/MapServer/tile/{z}/{y}/{x}', { attribution:'&copy; Esri &copy; OSM', maxZoom:16, className:'map-ref-labels' }).addTo(worldMap);
window.addEventListener('load',()=>worldMap.invalidateSize());
const toneColor={active:'#8FC31F',open:'#ffab00',planned:'#aab8ab'};
const floatCard=document.getElementById('map-float-card'),floatCardBody=document.getElementById('map-float-card-body');
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;').replace(/>/g,'&gt;');
let activeMarker=null;
function pfm(marker){const mc=worldMap.getContainer(),mr=mc.getBoundingClientRect(),p=worldMap.latLngToContainerPoint(marker.getLatLng());const cw=floatCard.offsetWidth||300,ch=floatCard.offsetHeight||160,m=18;let l=p.x+28,t=p.y-ch-20;if(t<m)t=p.y+28;if(l+cw>mr.width-m)l=p.x-cw-28;if(l<m)l=m;if(t<m)t=m;if(t+ch>mr.height-m)t=mr.height-ch-m;floatCard.style.left=l+'px';floatCard.style.top=t+'px';}
function sfc(p,marker){const c=toneColor[p.tone];floatCardBody.innerHTML='<div class="project-preview"><img src="'+(base+'/'+(p.img||''))+'" alt="'+esc(p.name)+'" onerror="this.style.display=\'none\'"></div><span class="card-status" style="background:'+c+'22;color:'+c+'">'+({active:'Deployed',open:'In Progress',planned:'Open to Collaborate'}[p.tone]||p.status)+'</span><h5 class="font-display font-bold text-ink text-base mt-3 mb-1">'+esc(p.name)+'</h5><p class="text-xs text-brand-deep mb-2">'+esc(p.location)+'</p><p class="text-xs text-muted leading-relaxed">'+esc(p.summary)+'</p>';floatCard.classList.add('visible');pfm(marker);activeMarker=marker;}
function hfc(){floatCard.classList.remove('visible');activeMarker=null;}
function closeCaseModal(){document.getElementById('case-modal').classList.remove('open');document.body.style.overflow='';}
function ocm(pid){const p=PROJECTS.find(x=>x.id===pid);if(!p)return;const preview=document.getElementById('modal-img');preview.className='modal-img';preview.innerHTML='<img src="'+(base+'/'+(p.img||''))+'" alt="'+esc(p.name)+'" style="width:100%;height:100%;object-fit:cover;border-radius:.75rem" onerror="this.style.display=\'none\'">';document.getElementById('modal-title').textContent=p.name;document.getElementById('modal-meta').textContent=p.location;document.getElementById('modal-desc').textContent=p.desc;document.getElementById('modal-tags').innerHTML=p.tags.map(t=>'<span>'+esc(t)+'</span>').join('');const sb=document.getElementById('modal-status-badge');const sc=toneColor[p.tone];sb.style.background=sc+'22';sb.style.color=sc;sb.textContent=({active:'Deployed',open:'In Progress',planned:'Open to Collaborate'}[p.tone]||p.status);const se=document.getElementById('modal-stats');if(p.stats&&p.stats.length){se.style.display='grid';se.innerHTML=p.stats.map(s=>'<div class="modal-stat"><div class="val">'+esc(s.val)+'</div><div class="lbl">'+esc(s.lbl)+'</div></div>').join('');}else{se.style.display='none';}const cta=document.getElementById('modal-cta');if(p.link){cta.href=p.link;cta.style.display='inline-flex';cta.textContent=p.linkText||'View Full Case';}else{cta.style.display='none';}document.getElementById('case-modal').classList.add('open');document.querySelector('.case-modal').scrollTop=0;document.body.style.overflow='hidden';}
document.getElementById('case-modal-close-btn').addEventListener('click',function(e){e.stopPropagation();closeCaseModal();});
document.getElementById('case-modal').addEventListener('click',function(e){if(e.target===this)closeCaseModal();});
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeCaseModal();});
const markers={};
PROJECTS.forEach(p=>{const icon=L.divIcon({className:'',html:'<div class="pin-marker '+p.tone+'"><div class="wave-ring"></div><div class="wave-ring"></div><div class="wave-ring"></div><div class="dot"></div></div>',iconSize:[40,40],iconAnchor:[20,20]});const marker=L.marker(p.coords,{icon,title:p.name,riseOnHover:true,keyboard:true}).addTo(worldMap);markers[p.id]=marker;marker.on('mouseover',()=>sfc(p,marker));marker.on('mouseout',()=>{setTimeout(()=>{if(activeMarker===marker&&!floatCard.matches(':hover'))hfc();},150);});marker.on('click',()=>ocm(p.id));});
floatCard.addEventListener('mouseenter',()=>{if(activeMarker)floatCard.classList.add('visible');});
floatCard.addEventListener('mouseleave',()=>hfc());
worldMap.on('move zoom',()=>{if(activeMarker&&floatCard.classList.contains('visible'))pfm(activeMarker);});
const filterBtns=document.querySelectorAll('.filter-btn');
const tagMap={'tnc':['Environmental','IoT'],'bhutan':['CV','LoRa','Tracker'],'mothbox-panama':['CV','LoRa'],'mothbox-peru':['CV','LoRa'],'mothbox-yellowstone':['CV','LoRa'],'olfactory':['Environmental'],'collarid':['CV','LoRa','Tracker'],'lifescience':['CV','Environmental','LoRa']};
filterBtns.forEach(btn=>{btn.addEventListener('click',()=>{filterBtns.forEach(b=>b.classList.remove('active'));btn.classList.add('active');const f=btn.dataset.filter;Object.keys(markers).forEach(k=>{const tags=tagMap[k]||[];if(f==='all'||tags.includes(f))worldMap.addLayer(markers[k]);else worldMap.removeLayer(markers[k]);});});});
const esc2=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;').replace(/>/g,'&gt;');
function bcr(tid,projects){const track=document.getElementById(tid);track.innerHTML='';const items=[...projects,...projects];items.forEach(p=>{const card=document.createElement('div');card.className='carousel-card';card.innerHTML='<span class="c-dot '+p.tone+'"></span><div class="c-body"><h4>'+esc2(p.name)+'</h4><p>'+esc2(p.summary)+'</p></div><div class="c-right"><span class="c-label '+p.tone+'">'+({active:'Deployed',open:'In Progress',planned:'Open to Collaborate'}[p.tone]||p.status)+'</span><span class="c-chev">→</span></div>';card.addEventListener('click',()=>{const m=markers[p.id];if(m){worldMap.setView(m.getLatLng(),worldMap.getZoom()>=4?worldMap.getZoom():4,{animate:true});sfc(p,m);}ocm(p.id);});track.appendChild(card);});let drag=false,sx=0,sl=0;track.addEventListener('mousedown',function(e){drag=true;track.classList.add('dragging');sx=e.pageX-this.offsetLeft;sl=this.offsetLeft;});track.addEventListener('mouseleave',function(){if(drag){drag=false;track.classList.remove('dragging');}});track.addEventListener('mouseup',function(){drag=false;track.classList.remove('dragging');});track.addEventListener('mousemove',function(e){if(!drag)return;e.preventDefault();const x=e.pageX-this.offsetLeft;this.style.transform=`translateX(${sl+(x-sx)*1.5}px)`;});track.addEventListener('touchstart',function(e){drag=true;track.classList.add('dragging');sx=e.touches[0].pageX-this.offsetLeft;sl=this.offsetLeft;});track.addEventListener('touchend',function(){drag=false;track.classList.remove('dragging');});track.addEventListener('touchmove',function(e){if(!drag)return;const x=e.touches[0].pageX-this.offsetLeft;this.style.transform=`translateX(${sl+(x-sx)*1.5}px)`;});}
bcr('carousel-track-1',PROJECTS.filter(p=>p.tone==='active'));
bcr('carousel-track-2',PROJECTS.filter(p=>p.tone!=='active'));
</script>
