---
const base = import.meta.env.BASE_URL;

const items = [
  {
    photo: `${base}/images/why-dolphin.jpg`,
    photoCap: 'Dolphin — Brazil', photoCapZh: '海豚 — 巴西',
    title: 'Cross-species collaboration is nothing new.', titleZh: '跨物种协作并非新鲜事。',
    body: 'Honeyguides lead hunters. Dolphins signal when to cast. Cormorants and hunting eagles have worked under human command for centuries. Homing pigeons carried addressed messages. Each was a real protocol — precise, effective, but hard to scale.', bodyZh: '响蜜鴷引领猎人。海豚示意何时撒网。鸬鹚和猎鹰在人类指挥下工作了数个世纪。信鸽传递有收件人的信件。每一个都是真实的协议——精准、有效，但难以规模化。',
  },
  {
    photo: `${base}/images/why-cormorant.jpg`,
    photoCap: 'Cormorant — China', photoCapZh: '鸬鹚 — 中国',
    title: 'The signals were never the issue. The network was.', titleZh: '信号从来不是问题。网络才是。',
    body: 'Calls, gaits, stripe patterns, water quality, temperature — animals and ecosystems have been broadcasting all of this for millions of years. What has always been missing is just the receiver: a shared network that connects them all.', bodyZh: '鸣叫、步态、条纹图案、水质、温度——动物和生态系统已将这些信号广播了数百万年。一直缺失的只是接收端：一个将它们全部连接起来的共享网络。',
  },
  {
    photo: `${base}/images/why-eagle.jpg`,
    photoCap: 'Golden Eagle — Mongolia', photoCapZh: '金雕 — 蒙古',
    title: 'Now the missing layer is finally here.', titleZh: '缺失的一层终于到来。',
    body: 'Edge AI, open-source hardware, and low-power mesh networks have crossed a threshold. For the first time, we can listen at scale — and those old handshakes can become a network.', bodyZh: '边缘 AI、开源硬件和低功耗 Mesh 网络已跨过临界点。我们第一次可以大规模聆听——那些古老的握手协议终将连成网络。',
  },
  {
    photo: `${base}/images/why-pigeon.jpg`,
    photoCap: 'Homing Pigeon', photoCapZh: '信鸽',
    title: "We don't speak for animals. We build the tools that let them be heard.", titleZh: '我们不代表动物发声。我们构建让它们被听见的工具。',
    body: "Seeed is not a lab that speaks for animals. We build the open-source hardware that lets researchers and local teams turn those signals into useful knowledge — so any species, any ecosystem, can finally be heard.", bodyZh: 'Seeed 不是代表动物发声的实验室。我们构建开源硬件，让研究者和本地团队将这些信号转化为有用知识——使任何物种、任何生态系统终能被听见。',
  },
];
---

<!-- ============ WHY NOW ============ -->
<section id="why" class="why-section">
  <div class="why-top-label"><span data-en="Why Now" data-zh="为何此刻">Why Now</span></div>

  <div class="why-items">
    {items.map((item, i) => (
      <div class={`why-row ${i % 2 === 0 ? 'why-row-l' : 'why-row-r'}`} data-why-idx={i}>
        <div class={`why-photo ${i % 2 === 0 ? 'order-2' : 'order-1'}`}>
          <img src={item.photo} alt={item.photoCap} loading="lazy" data-cap-en={item.photoCap} data-cap-zh={item.photoCapZh} />
          <span class="why-photo-cap" data-en={item.photoCap} data-zh={item.photoCapZh}>{item.photoCap}</span>
        </div>
        <div class={`why-copy ${i % 2 === 0 ? 'order-1' : 'order-2'}`}>
          <h3 data-en={item.title} data-zh={item.titleZh}>{item.title}</h3>
          <p data-en={item.body} data-zh={item.bodyZh}>{item.body}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- snake-line connector -->
<div class="why-connector">
  <svg viewBox="0 0 120 90" preserveAspectRatio="none">
    <defs>
      <linearGradient id="why-conn-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#8FC31F"/>
        <stop offset="100%" stop-color="#00936d"/>
      </linearGradient>
    </defs>
    <path id="why-signal-path" d="M60,0 C60,18 20,28 60,45 C100,62 20,72 60,90" fill="none" stroke="url(#why-conn-grad)" stroke-width="2" stroke-dasharray="5,4" opacity="0.75"/>
    <circle r="3.5" fill="#8FC31F">
      <animateMotion dur="2.5s" repeatCount="indefinite"><mpath href="#why-signal-path"/></animateMotion>
    </circle>
  </svg>
</div>

<style>
.why-section{background:linear-gradient(180deg,#ddf0c4 0%,#d8ecda 25%,#cfe5e8 55%,#c8dfe2 80%,#c2dae0 100%);padding:4.5rem 0 2rem;position:relative;overflow:visible}
.why-top-label{position:absolute;top:1.2rem;left:50%;transform:translateX(-50%);z-index:6}
.why-top-label span{display:inline-block;font-family:'Space Grotesk',sans-serif;font-size:11px;font-weight:700;letter-spacing:4px;color:#5a8a16;background:rgba(255,255,255,.75);padding:5px 18px;border-radius:9999px;border:1px solid rgba(143,195,31,.35);box-shadow:0 2px 10px rgba(143,195,31,.18)}

.why-items{max-width:960px;margin:0 auto;padding:2.5rem 2rem 1rem}
.why-row{display:flex;align-items:center;gap:2.5rem;margin-bottom:4rem;opacity:0;transform:translateY(30px);transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1)}
.why-row.active{opacity:1;transform:translateY(0)}

.why-photo{flex:0 0 54%;position:relative}
.why-photo img{width:100%;aspect-ratio:3/2;object-fit:cover;border-radius:.75rem;box-shadow:0 8px 30px rgba(0,0,0,.18),0 2px 8px rgba(0,0,0,.1);transition:transform 1.2s cubic-bezier(.16,1,.3,1)}
.why-row.active .why-photo img{transform:scale(1)}
.why-row:not(.active) .why-photo img{transform:scale(1.06)}
.why-row-l .why-photo img{transform:rotate(1.5deg)}
.why-row-r .why-photo img{transform:rotate(-1.5deg)}
.why-row.active.why-row-l .why-photo img{transform:rotate(1.5deg) scale(1)}
.why-row.active.why-row-r .why-photo img{transform:rotate(-1.5deg) scale(1)}
.why-photo-cap{display:block;font-size:10px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:#5a8a16;margin-top:.4rem;text-align:center}

.why-copy{flex:1;min-width:0;max-width:42%}
.why-copy h3{font-family:'Playfair Display',Georgia,serif;font-weight:600;font-size:1.15rem;color:#2a2f33;margin-bottom:.5rem;line-height:1.35}
.why-copy p{font-size:.88rem;color:#6d6f70;line-height:1.75}

.why-connector{position:relative;height:90px;background:linear-gradient(180deg,#c2dae0 0%,#cdd9c8 40%,#f3f7ec 100%);overflow:visible;display:flex;justify-content:center;align-items:flex-start}
.why-connector svg{position:absolute;top:0;left:50%;transform:translateX(-50%);width:120px;height:90px;overflow:visible}

@media(max-width:768px){
  .why-row{flex-direction:column;gap:1.5rem;margin-bottom:3rem}
  .why-photo{flex:0 0 auto;width:96%}
  .why-copy{text-align:left}
  .why-row-l .order-1,.why-row-r .order-1{order:1}
  .why-row-l .order-2,.why-row-r .order-2{order:2}
}
</style>

<script>
(function(){
  var rows = document.querySelectorAll('.why-row');
  if (!rows.length) return;
  var observer = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting) {
        e.target.classList.add('active');
        observer.unobserve(e.target);
      }
    });
  }, {threshold: 0.35, rootMargin: '0px 0px -120px 0px'});
  rows.forEach(function(r){ observer.observe(r); });
})();
</script>
