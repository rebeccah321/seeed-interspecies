---
const base = import.meta.env.BASE_URL;

const items = [
  {
    photo: `${base}/images/why-dolphin.jpg`,
    photoCap: 'Dolphin — Brazil', photoCapZh: '海豚 — 巴西',
    title: 'Cross-species collaboration is nothing new.', titleZh: '跨物种协作并非新鲜事。',
    body: 'Honeyguides lead hunters. Dolphins signal when to cast. Cormorants and hunting eagles have worked under human command for centuries. Homing pigeons carried addressed messages. Each was a real protocol — precise, effective, but hard to scale.', bodyZh: '响蜜鴷引领猎人。海豚示意何时撒网。鸬鹚和猎鹰在人类指挥下工作了数个世纪。信鸽为指定收件人传信。每一种都是真正的协议——精准、有效，却难以规模化。',
  },
  {
    photo: `${base}/images/why-cormorant.jpg`,
    photoCap: 'Cormorant — China', photoCapZh: '鸬鹚 — 中国',
    title: 'The signals were never the issue. Scaling was.', titleZh: '信号从来不是问题。规模化才是。',
    body: 'Animals and ecosystems have been broadcasting signals for millions of years. From Interspecies Internet to field labs, a global network of researchers has already mapped how these species communicate, think, and live together. What was missing was the receiver: open hardware to turn that knowledge into action at scale.', bodyZh: '动物和生态系统持续广播信号已有数百万年。从 Interspecies Internet 到野外实验室，全球研究者网络已经绘出这些物种如何交流、认知与共处。缺的只是接收端：能把这份知识大规模转化为行动的开源硬件。',
  },
  {
    photo: `${base}/images/why-eagle.jpg`,
    photoCap: 'Golden Eagle — Mongolia', photoCapZh: '金雕 — 蒙古',
    title: 'Now the missing layer is finally here.', titleZh: '缺失的那一层，终于就位。',
    body: 'Edge AI, open-source hardware, and low-power mesh networks have crossed a threshold. For the first time, we can listen at scale — and those old handshakes can become a network.', bodyZh: '边缘 AI、开源硬件和低功耗 Mesh 网络已跨过临界点。我们第一次可以大规模聆听——那些古老的握手协议终于可以连成网络。',
  },
  {
    photo: `${base}/images/why-pigeon.jpg`,
    photoCap: 'Homing Pigeon', photoCapZh: '信鸽',
    title: "We don't speak for animals. We build the tools that let them be heard.", titleZh: '我们不代表动物发声。我们构建让它们被听见的工具。',
    body: "Seeed doesn't speak for animals. We build the open hardware layer so researchers and local teams can turn field signals into knowledge — and any species, any ecosystem can finally be heard.", bodyZh: 'Seeed 不替动物说话。我们构建开源硬件层，让研究者和本地团队能把野外信号转化为知识——任何物种、任何生态系统都能因此被听见。',
  },
];
---

<!-- ============ WHY NOW ============ -->
<section id="why" class="why-section">
  <div class="why-top-label"><span data-en="Why Now" data-zh="为何此刻">Why Now</span></div>

  <div class="why-items" id="why-items">
    {items.map((item, i) => (
      <div class={`why-row ${i % 2 === 0 ? 'why-row-l' : 'why-row-r'}`} data-why-idx={i}>
        <div class={`why-photo ${i % 2 === 0 ? 'order-2' : 'order-1'}`}>
          <img src={item.photo} alt={item.photoCap} loading="lazy" />
          <span class="why-photo-cap" data-en={item.photoCap} data-zh={item.photoCapZh}>{item.photoCap}</span>
        </div>
        <div class={`why-copy ${i % 2 === 0 ? 'order-1' : 'order-2'}`}>
          <h3 data-en={item.title} data-zh={item.titleZh}>{item.title}</h3>
          <p data-en={item.body} data-zh={item.bodyZh}>{item.body}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style is:global>
.why-section{
  background:linear-gradient(180deg,#ddf0c4 0%,#d8ecda 25%,#cfe5e8 55%,#c8dfe2 80%,#c2dae0 100%);
  padding:2.5rem 0 1.5rem;position:relative;overflow:hidden;
}
.why-top-label{position:absolute;top:1rem;left:50%;transform:translateX(-50%);z-index:6}
.why-top-label span{
  display:inline-block;font-family:'Space Grotesk',sans-serif;font-size:11px;font-weight:700;
  letter-spacing:4px;color:#5a8a16;background:rgba(255,255,255,.75);padding:5px 18px;
  border-radius:9999px;border:1px solid rgba(143,195,31,.35);box-shadow:0 2px 10px rgba(143,195,31,.18);
}

.why-items{max-width:860px;margin:0 auto;padding:2.2rem 2rem 0.5rem}

.why-row{
  display:flex;align-items:center;gap:1.5rem;margin-bottom:0.6rem;
  opacity:0;transform:translateY(20px);
  transition:opacity .6s cubic-bezier(.16,1,.3,1),transform .6s cubic-bezier(.16,1,.3,1);
}
.why-row.appeared{opacity:1;transform:translateY(0)}

.why-photo{
  flex:0 0 38%;position:relative;
  transition:flex-basis .5s cubic-bezier(.16,1,.3,1);
}
.why-row-l .why-photo{transform:translateX(3.5rem)}
.why-row-r .why-photo{transform:translateX(-3.5rem)}

.why-photo img{
  width:100%;aspect-ratio:3/2;object-fit:cover;border-radius:.5rem;
  box-shadow:0 6px 22px rgba(0,0,0,.18),0 1px 4px rgba(0,0,0,.1);
  transform:rotate(2deg) translateX(55px) scale(.92);
  opacity:0;
  transition:transform .65s cubic-bezier(.16,1,.3,1),opacity .5s ease;
}
.why-row-r .why-photo img{transform:rotate(-2deg) translateX(-55px) scale(.92)}

.why-row.appeared.why-row-l .why-photo img{transform:rotate(2deg) translateX(0px) scale(1);opacity:1}
.why-row.appeared.why-row-r .why-photo img{transform:rotate(-2deg) translateX(0px) scale(1);opacity:1}

.why-row.active.why-row-l .why-photo img{transform:rotate(2deg) translateX(0px) scale(1.03);opacity:1}
.why-row.active.why-row-r .why-photo img{transform:rotate(-2deg) translateX(0px) scale(1.03);opacity:1}

.why-row.compact.why-row-l .why-photo img{transform:rotate(1deg) translateX(0px) scale(.88);opacity:.55}
.why-row.compact.why-row-r .why-photo img{transform:rotate(-1deg) translateX(0px) scale(.88);opacity:.55}

.why-section.overview .why-row.why-row-l .why-photo img{transform:rotate(2deg) translateX(0px) scale(1);opacity:.85}
.why-section.overview .why-row.why-row-r .why-photo img{transform:rotate(-2deg) translateX(0px) scale(1);opacity:.85}

.why-row.appeared.why-row-l:hover .why-photo img{transform:rotate(2deg) translateX(0px) scale(1.1);opacity:1}
.why-row.appeared.why-row-r:hover .why-photo img{transform:rotate(-2deg) translateX(0px) scale(1.1);opacity:1}

.why-photo-cap{
  position:absolute;bottom:.35rem;left:.5rem;
  font-size:9px;font-weight:600;letter-spacing:1px;text-transform:uppercase;
  color:#fff;background:rgba(0,0,0,.4);padding:2px 8px;border-radius:4px;
  backdrop-filter:blur(4px);opacity:0;transition:opacity .3s ease;
}
.why-row.appeared .why-photo-cap{opacity:1}

.why-copy{flex:1;min-width:0}
.why-copy h3{
  font-family:'Playfair Display',Georgia,serif;font-weight:600;
  font-size:.9rem;color:#2a2f33;margin-bottom:.2rem;line-height:1.35;
  transition:font-size .3s ease,color .3s ease,opacity .3s ease;
}
.why-copy p{
  font-size:.78rem;color:#6d6f70;line-height:1.65;
  max-height:0;overflow:hidden;opacity:0;
  transition:max-height .5s cubic-bezier(.16,1,.3,1),opacity .4s ease;
}

.why-row.active h3{font-size:.95rem;color:#1a231a}
.why-row.active p{max-height:7rem;opacity:1}

.why-row.compact h3{font-size:.82rem;opacity:.6}
.why-row.compact p{max-height:0;opacity:0}

.why-section.overview .why-row h3{font-size:.88rem;opacity:1}
.why-section.overview .why-row p{
  max-height:2.6rem;opacity:.5;
  -webkit-mask:linear-gradient(180deg,#000 35%,transparent 100%);
  mask:linear-gradient(180deg,#000 35%,transparent 100%);
}

.why-row.appeared:hover h3{font-size:1rem;color:#1a231a}
.why-row.appeared:hover p{max-height:7rem;opacity:1;-webkit-mask:none;mask:none}
.why-row.appeared:hover .why-photo{flex-basis:46%}

.why-items:hover .why-row.appeared:not(:hover){opacity:.35}

.why-row.active .why-photo{flex-basis:44%}
.why-row.compact .why-photo{flex-basis:32%}
.why-section.overview .why-row .why-photo{flex-basis:38%}

@media(max-width:768px){
  .why-items{padding:2rem 1.2rem 0.5rem}
  .why-row{flex-direction:column;gap:.8rem;margin-bottom:1rem}
  .why-photo{flex:0 0 auto;width:100%}
  .why-row-l .why-photo,.why-row-r .why-photo{transform:none}
  .why-row-l .order-1,.why-row-r .order-1{order:1}
  .why-row-l .order-2,.why-row-r .order-2{order:2}
  .why-row.active p,.why-section.overview .why-row p{
    max-height:5rem;opacity:1;-webkit-mask:none;mask:none;
  }
}
</style>

<script>
(function(){
  var section = document.getElementById('why');
  if (!section) return;
  var rows = section.querySelectorAll('.why-row');
  var started = false;
  var perCard = 3000;

  function activate(idx) {
    if (section.classList.contains('overview')) return;
    for (var i = 0; i < idx; i++) {
      if (rows[i]) {
        rows[i].classList.add('appeared','compact');
        rows[i].classList.remove('active');
      }
    }
    if (rows[idx]) {
      rows[idx].classList.add('appeared','active');
      rows[idx].classList.remove('compact');
    }
  }

  function skipToOverview() {
    section.classList.add('overview');
    rows.forEach(function(row){
      row.classList.add('appeared');
      row.classList.remove('active','compact');
    });
  }

  function startSequence() {
    if (started) return;
    started = true;
    activate(0);
    for (var i = 1; i < rows.length; i++) {
      (function(idx){
        setTimeout(function(){ activate(idx); }, idx * perCard);
      })(i);
    }
    setTimeout(function(){
      if (!section.classList.contains('overview')) {
        skipToOverview();
      }
    }, rows.length * perCard + 600);
  }

  rows.forEach(function(row){
    row.addEventListener('mouseenter', function(){
      if (started && !section.classList.contains('overview')) {
        skipToOverview();
      }
    });
  });

  var observer = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting) {
        startSequence();
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.25 });
  observer.observe(section);
})();
</script>
